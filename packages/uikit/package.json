{
  "name": "@agora/ai-agent-uikit",
  "version": "0.1.0",
  "description": "AI Agent UIKit for React - A comprehensive component library for building AI agents that use real-time voice and video communication",
  "keywords": [
    "agora",
    "ai-agent",
    "uikit",
    "voice",
    "video",
    "ai",
    "react",
    "components",
    "ui",
    "rtc"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/agora/agora-ai-builder-ui"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./assets/*": "./dist/assets/*",
    "./styles/*": "./dist/styles/*"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format:write": "prettier --write \"src/**/*.{ts,tsx}\" --cache",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" --cache"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "agora-rtc-react": ">=2.0.0",
    "agora-rtm-sdk": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "agora-rtc-react": {
      "optional": false
    },
    "agora-rtm-sdk": {
      "optional": true
    }
  },
  "dependencies": {
    "@lottiefiles/dotlottie-react": "^0.17.6",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.1.13",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.554.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "tsup": "^8.0.0",
    "typescript": "^5"
  }
}
